    "email": "sandeepk@testmuai.com"
  },
  "commands": "./commands",
  "tools": {
    "webpackRouteExtractor": "./tools/webpack.routes.config.js",
    "routeExtractorPlugin": "./tools/route-extractor-plugin.js",
    "routeExtractorLoader": "./tools/route-extractor-loader.js",
    "ensureLogin": "./tools/ensure-login.sh",
    "cookieLogin": "./tools/cookie-login.js",
    "checkAuth": "./tools/check-auth.js",
    "captureRoutes": "./tools/capture-routes.js",
    "buildReport": "./tools/build-report.js",
    "serveReport": "./tools/serve-report.js",
    "generateReport": "./generate-report.sh"
  }
