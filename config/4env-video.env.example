# config/4env-video.env — per-route VIDEO across N environments, side by side.
# Consumed by ./generate-4env-video.sh. Everything here is a knob; nothing is
# hardcoded into the tool. cookieJar is '' for an unauthenticated env or an abs
# path to a Playwright storageState file (mint via tools/cookie-login.js).

# one shared extract-routes.js JSON (run: node tools/extract-routes.js /repo --json > routes.json)
ROUTES_JSON=/abs/path/routes.json

# ENVS = "key|label|baseURL|cookieJar" rows, ';'-separated. Column order in the
# report follows row order. before/after × prod/onprem reads naturally as 4 rows.
ENVS="before-prod|before Prod|https://before-host:3001|/abs/.auth/prod-cookies.json; \
after-prod|after Prod|https://after-host:3003|/abs/.auth/prod-cookies.json; \
before-onprem|before On-Prem|https://before-onprem:3000|/abs/.auth/onprem-cookies.json; \
after-onprem|after On-Prem|https://after-onprem:3002|/abs/.auth/onprem-cookies.json"

CAP=6          # per-level interactive-element cap (logged when hit)
DEPTH=1        # recurse depth into revealed subtrees
PORT=3010      # DevSpace auto-maps this to a public https URL
# MAX=20       # optional: cap number of routes
TITLE="Per-route Video — 4-env prod/onprem before-after sync comparison"
