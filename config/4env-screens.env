# 4env-screens.env — 4-env SCREENSHOT comparison for prod-onprem-sync.
# before/after × prod/onprem, side-by-side per route. Drives generate-report.sh
# (capture-routes.js screenshot pipeline, NOT the video pipeline).
#
# Routes reused from reports/routes.generated.json (SKIP_EXTRACT=1).
# Per-origin cookie jars: prod jar (.lambdatest.com) for prod origins,
# onprem jar (.hyperexecute.cloud) for onprem origins. Re-mint via cookie-login.js.

ROUTE_SRC=/home/claude/workspace/lambda-invigilator-client/src/routes/index.tsx
CHECK_URL=/details/profile

# capture-routes.js ORIGINS: "label=url=/abs/cookiejar" rows, ';'-separated.
# Column/order in report follows row order: before-prod, after-prod, before-onprem, after-onprem.
ORIGINS="before-prod=https://before-fae34c-3001.lambdatest.com=/home/claude/workspace/route-wise-screenshot-comparison-tool/reports/.auth/prod-cookies.json;after-prod=https://after-fae34c-3003.lambdatest.com=/home/claude/workspace/route-wise-screenshot-comparison-tool/reports/.auth/prod-cookies.json;before-onprem=https://hyperexecute-onprem-before-fae34c-3000.hyperexecute.cloud=/home/claude/workspace/route-wise-screenshot-comparison-tool/reports/.auth/onprem-cookies.json;after-onprem=https://hyperexecute-onprem-after-fae34c-3002.hyperexecute.cloud=/home/claude/workspace/route-wise-screenshot-comparison-tool/reports/.auth/onprem-cookies.json"

PORT=3011
