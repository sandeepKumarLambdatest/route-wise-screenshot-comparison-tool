# config/4env-video-templated.env — capture REAL-value representatives of templated
# routes (tab/provider enums from source + the authed user's own uuid). Token/one-time
# -id templated routes are NOT here (logged skipped-needs-id; no fabricated ids).
ROUTES_JSON=/tmp/templated-reps.json
ENVS="before-prod|before Prod|https://before-fae34c-3001.lambdatest.com|/home/claude/workspace/route-wise-screenshot-comparison-tool/reports/.auth/prod-cookies.json; \
after-prod|after Prod|https://after-fae34c-3003.lambdatest.com|/home/claude/workspace/route-wise-screenshot-comparison-tool/reports/.auth/prod-cookies.json; \
before-onprem|before On-Prem|https://hyperexecute-onprem-before-fae34c-3000.hyperexecute.cloud|/home/claude/workspace/route-wise-screenshot-comparison-tool/reports/.auth/onprem-cookies.json; \
after-onprem|after On-Prem|https://hyperexecute-onprem-after-fae34c-3002.hyperexecute.cloud|/home/claude/workspace/route-wise-screenshot-comparison-tool/reports/.auth/onprem-cookies.json"
CAP=4
DEPTH=0
WAITUNTIL=domcontentloaded
SERVE=0
RUN=4env-templated
TITLE="Per-route Video — 4-env (templated representatives)"
