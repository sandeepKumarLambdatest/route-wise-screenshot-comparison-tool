# target.env — copy to config/target.env and fill in. NEVER commit real creds.
# (config/target.env is gitignored; keep EMAIL/PASSWORD in a separate CRED_FILE.)

# ── route extraction (step 1) ──
# Absolute path(s) to the SPA route module(s) webpack parses. Comma-separate many.
ROUTE_SRC=/home/claude/route-merge-harness/src/routes/index.tsx

# ── target origins ──
# The SPA origin used for the login check.
BASE=https://accounts.lambdatest.com
# A protected route that redirects to /login when unauthenticated.
CHECK_URL=/details/profile

# ── login API (curl-cookie fallback, step 2) ──
# Only used when BASE has no valid session yet.
LOGIN_API=https://auth.lambdatest.com/api/login
ORIGIN=https://accounts.lambdatest.com
COOKIE_DOMAIN=.lambdatest.com
EMAIL_FIELD=email
PASSWORD_FIELD=password
# If the API returns the token in the JSON body instead of Set-Cookie:
# TOKEN_COOKIE=accessToken
# Creds live OUTSIDE this file:
CRED_FILE=$HOME/.claude/secrets/account.env   # must export EMAIL and PASSWORD

# ── capture (step 3) ──
# single snapshot:  ORIGINS="prod=https://accounts.lambdatest.com"
# before/after:     ORIGINS="before=https://a;after=https://b"
ORIGINS=before=https://accounts.lambdatest.com;after=https://accounts.lambdatest.com
# INCLUDE_TEMPLATED=1   # also capture :id/:token routes (skipped by default)
# MAX_ROUTES=5          # quick smoke

# ── serve (step 5) ──
PORT=5056
# SERVE=0   # build only, don't serve
