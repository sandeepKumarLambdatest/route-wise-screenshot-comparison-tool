# video.env — copy to config/video.env and fill in. Drives generate-video-report.sh.
# Per-route VIDEO + runtime interactive-coverage report. Token-free, re-runnable.

# ── the served app under test ──
BASE=http://localhost:3000

# ── route source (set exactly ONE) ──
# REPO=/abs/path/to/spa           # extract routes from a repo (extract-routes.js)
# ROUTES_JSON=/abs/routes.json    # reuse a pre-extracted extract-routes.js JSON
URL_ONE=/                          # record a SINGLE path (direct full-page nav)

# ── recording / walk knobs ──
VIDEO=1            # 1 = record .webm per route; 0 = coverage walk only (no video)
# MAX=10          # cap number of routes
# CAP=60          # cap interactive elements exercised PER tree level
# DEPTH=4         # max reveal-recursion depth (modal/menu/accordion subtrees)
# HASH=1          # app uses HashRouter (deep-link via #/path)
# TEMPLATED=1     # also record :id/:token routes (skipped by default)
# COVERAGE_JSON=/abs/test-map.json  # webpack test-map to drive the matrix instead

# ── output / serve ──
# OUT=reports/<RUN>/videos
# REPORT=reports/<RUN>/report
PORT=5057
# SERVE=0         # build only, don't serve
